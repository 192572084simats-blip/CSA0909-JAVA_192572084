class ParkingTicket {
    private static int nextTicketNumber = 1000;
    private static int totalTicketsCreated = 0;

    private final int ticketNumber;
    private final String registrationNumber;

    static {
        System.out.println("Parking ticket system initialized.");
    }

    public ParkingTicket(String registrationNumber) {
        this.registrationNumber = registrationNumber;
        this.ticketNumber = ++nextTicketNumber;
        totalTicketsCreated++;
    }

    public void display() {
        System.out.println("Ticket: " + ticketNumber
                + ", Vehicle: " + registrationNumber);
    }

    public static int getTotalTicketsCreated() {
        return totalTicketsCreated;
    }
}

public class Task05 {
    public static void main(String[] args) {
        ParkingTicket t1 = new ParkingTicket("TN01AB1111");
        ParkingTicket t2 = new ParkingTicket("TN02CD2222");
        ParkingTicket t3 = new ParkingTicket("TN03EF3333");

        t1.display();
        t2.display();
        t3.display();
        System.out.println("Total tickets created: "
                + ParkingTicket.getTotalTicketsCreated());

        t2 = null; // object may become eligible for garbage collection
        System.out.println("Ticket reference t2 cleared.");
    }
}
